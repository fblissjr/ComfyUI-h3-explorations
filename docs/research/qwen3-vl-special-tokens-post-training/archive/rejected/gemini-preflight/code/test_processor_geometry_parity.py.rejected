#!/usr/bin/env python3
"""
Phase C: Processor & Geometry Parity Fixtures.
Records and validates input geometry, spatial 32-px alignment, 2x2 spatial merge,
unmerged patch counts, merged token counts, grid_thw, and normalization constants
across representative still image and video geometries under Native vs AWQ policies.
"""

import sys
from pathlib import Path
import torch

REPO_ROOT = Path("<HOME>/ComfyUI/custom_nodes/ComfyUI-h3-explorations")
sys.path.insert(0, str(REPO_ROOT / "docs/research/qwen3-vl-special-tokens-post-training/preflight/code"))

from native_h3_builder import process_still_image, process_video_block


def run_geometry_parity():
    print("=== Running Phase C: Processor & Geometry Parity Fixtures ===")

    test_cases = [
        ("Landscape 16:9 Still", torch.rand((720, 1280, 3)), "image"),
        ("Portrait 9:16 Still", torch.rand((1280, 720, 3)), "image"),
        ("Square 1:1 High-Res Still", torch.rand((1024, 1024, 3)), "image"),
        ("Square 1:1 Low-Res Still", torch.rand((384, 384, 3)), "image"),
        ("Cinema 2.35:1 Ultrawide Still", torch.rand((544, 1280, 3)), "image"),
        ("Video 2 fps (4 frames, 2 blocks)", torch.rand((4, 768, 768, 3)), "video"),
        ("Video 2 fps (16 frames, 8 blocks)", torch.rand((16, 512, 512, 3)), "video"),
    ]

    results = []

    print("\n--- 1. Evaluating under AWQ Constrained Policy (200,704 to 301,056 px) ---")
    for name, media_tensor, kind in test_cases:
        if kind == "image":
            patches, grid = process_still_image(media_tensor, min_pixels=200704, max_pixels=301056)
            gh, gw = grid[0, 1].item(), grid[0, 2].item()
            unmerged = gh * gw
            merged = (gh // 2) * (gw // 2)
            results.append({
                "name": name,
                "policy": "AWQ Constrained",
                "input_shape": list(media_tensor.shape),
                "grid_thw": grid.tolist()[0],
                "unmerged_patches": unmerged,
                "merged_tokens": merged,
                "patch_tensor_shape": list(patches.shape)
            })
            print(f"[{name}] Input: {list(media_tensor.shape)} -> Grid: {grid.tolist()[0]} -> Unmerged: {unmerged}, Merged: {merged} tokens (Shape: {list(patches.shape)})")
            # Verify 264-289 range for common still images
            if "Still" in name and "Low-Res" not in name:
                assert 250 <= merged <= 320, f"Unexpected token count: {merged}"
        elif kind == "video":
            # Test block-by-block
            block_patches, grid = process_video_block(media_tensor[:2])
            gh, gw = grid[0, 1].item(), grid[0, 2].item()
            unmerged = gh * gw
            merged = (gh // 2) * (gw // 2)
            results.append({
                "name": name,
                "policy": "AWQ Video Policy",
                "input_shape": list(media_tensor.shape),
                "grid_thw": grid.tolist()[0],
                "unmerged_patches": unmerged,
                "merged_tokens": merged,
                "patch_tensor_shape": list(block_patches.shape)
            })
            print(f"[{name}] Input: {list(media_tensor.shape)} -> 2-Frame Block Grid: {grid.tolist()[0]} -> Merged: {merged} tokens/block")

    print("\n--- 2. Evaluating under Native Release Policy (65,536 to 16,777,216 px) ---")
    for name, media_tensor, kind in test_cases:
        if kind == "image":
            patches, grid = process_still_image(media_tensor, min_pixels=65536, max_pixels=16777216)
            gh, gw = grid[0, 1].item(), grid[0, 2].item()
            unmerged = gh * gw
            merged = (gh // 2) * (gw // 2)
            results.append({
                "name": name,
                "policy": "Native Release Policy",
                "input_shape": list(media_tensor.shape),
                "grid_thw": grid.tolist()[0],
                "unmerged_patches": unmerged,
                "merged_tokens": merged,
                "patch_tensor_shape": list(patches.shape)
            })
            print(f"[{name}] Input: {list(media_tensor.shape)} -> Grid: {grid.tolist()[0]} -> Unmerged: {unmerged}, Merged: {merged} tokens")

    # Output JSON summary
    out_json = REPO_ROOT / "docs/research/qwen3-vl-special-tokens-post-training/preflight/reports/processor_geometry_parity_results.json"
    with open(out_json, "w", encoding="utf-8") as f:
        json.dump(results, f, indent=2)
    print(f"\nWrote Geometry Parity Results to {out_json}")
    print("\nALL PROCESSOR & GEOMETRY PARITY FIXTURES VALIDATED SUCCESSFULLY.")


if __name__ == "__main__":
    import json
    run_geometry_parity()
