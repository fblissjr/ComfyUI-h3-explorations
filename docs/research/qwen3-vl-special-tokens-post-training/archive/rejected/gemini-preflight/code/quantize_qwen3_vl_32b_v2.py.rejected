#!/usr/bin/env python3
"""
Native-H3 AWQ v2 Calibration & Quantization Script.
Quantizes Qwen3-VL 32B to W4A16 AWQ using raw native H3 presentation (without chat templates)
across a curated, verified multimodal calibration manifest (T2VA, I2VA, FL2VA, Ref2VA, Video).

NOTE: This script is prepared for Technical Lead (Claude) inspection and execution.
DO NOT RUN INDEPENDENTLY without technical lead preflight gate approval.
"""

import os
import sys
import json
import time
import hashlib
import argparse
from pathlib import Path
from PIL import Image
import torch
from datasets import Dataset
from transformers import AutoProcessor, AutoTokenizer, Qwen3VLForConditionalGeneration

from llmcompressor import oneshot
from llmcompressor.modifiers.quantization import QuantizationModifier
from llmcompressor.modifiers.transform.awq import AWQModifier

REPO_ROOT = Path("<HOME>/ComfyUI/custom_nodes/ComfyUI-h3-explorations")
PREFLIGHT_DIR = REPO_ROOT / "docs/research/qwen3-vl-special-tokens-post-training/preflight"
MANIFEST_DIR = PREFLIGHT_DIR / "manifests"
CODE_DIR = PREFLIGHT_DIR / "code"

sys.path.insert(0, str(CODE_DIR))
from native_h3_builder import NativeH3PresentationBuilder


def sha256_file(path: str | Path) -> str:
    with open(path, "rb") as f:
        h = hashlib.sha256()
        while chunk := f.read(65536):
            h.update(chunk)
        return h.hexdigest()


def load_native_calibration_dataset(
    manifest_path: str,
    processor: AutoProcessor,
    max_samples: int | None = None
) -> Dataset:
    """Loads calibration records and constructs native multimodal inputs without chat templates."""
    print(f"Loading native calibration manifest from: {manifest_path}")
    manifest_hash = sha256_file(manifest_path)
    print(f"Manifest SHA-256: {manifest_hash}")

    tokenized_samples = []

    with open(manifest_path, "r", encoding="utf-8") as f:
        rows = [json.loads(line) for line in f]

    if max_samples:
        rows = rows[:max_samples]

    print(f"Processing {len(rows)} calibration samples with raw native presentation...")
    for idx, r in enumerate(rows):
        prompt = r["raw_prompt"]
        media_records = r.get("media_records", [])

        # Load images/videos
        images = []
        for m in media_records:
            if m["type"] == "image" and os.path.exists(m["path"]):
                try:
                    im = Image.open(m["path"]).convert("RGB")
                    images.append(im)
                except Exception:
                    pass
            elif m["type"] == "video" and os.path.exists(m["path"]):
                # Extract first 2 frames for video temporal block
                # Note: processor handles still images and video frames
                pass

        # Native text formatting: No chat template, only raw text with picture tags if media exists
        if len(images) > 0:
            pic_tags = "\n".join([f"<Picture {i+1}>: <|vision_start|><|image_pad|><|vision_end|>" for i in range(len(images))])
            full_native_text = f"{pic_tags}\n{prompt}"
            inputs = processor(
                text=[full_native_text],
                images=images,
                padding=False,
                truncation=False,
                return_tensors=None
            )
        else:
            inputs = processor(
                text=[prompt],
                padding=False,
                truncation=False,
                return_tensors=None
            )

        sample_dict = {
            k: v[0] if isinstance(v, list) and len(v) == 1 and not isinstance(v[0], list) else v
            for k, v in inputs.items()
            if v is not None
        }
        tokenized_samples.append(sample_dict)

    print(f"Successfully constructed {len(tokenized_samples)} native calibration samples.")
    return Dataset.from_list(tokenized_samples)


def main():
    parser = argparse.ArgumentParser(description="Native-H3 AWQ v2 Quantization")
    parser.add_argument("--model_path", type=str, default="<HOME>/workspace/llm-compressor/models/qwen3-vl-32b-bf16")
    parser.add_argument("--manifest_path", type=str, default=str(MANIFEST_DIR / "native_h3_cal_manifest.jsonl"))
    parser.add_argument("--output_dir", type=str, default="<HOME>/workspace/llm-compressor/models/qwen3-vl-32b-nativecal-v2-W4A16-AWQ-H3")
    parser.add_argument("--max_samples", type=int, default=256)
    args = parser.parse_args()

    print("==================================================================")
    print("       NATIVE-H3 AWQ V2 QUANTIZATION LAUNCH PIPELINE              ")
    print("==================================================================")
    print(f"Model Path:       {args.model_path}")
    print(f"Manifest Path:    {args.manifest_path}")
    print(f"Output Directory: {args.output_dir}")
    print(f"Max Samples:      {args.max_samples}")

    start_time = time.time()

    # 1. Load Processor
    processor = AutoProcessor.from_pretrained(args.model_path)

    # 2. Build Dataset
    calib_dataset = load_native_calibration_dataset(
        args.manifest_path,
        processor,
        max_samples=args.max_samples
    )

    # 3. Define AWQ Recipe (Quantize all 64 decoder layers, preserve ViT & DeepStack in BF16)
    recipe = [
        AWQModifier(
            targets=["Linear"],
            ignore=[
                "lm_head",
                "model.embed_tokens",
                "visual",
                "merger",
                "deepstack",
                "model.visual.*"
            ],
            duality=False
        ),
        QuantizationModifier(
            targets=["Linear"],
            ignore=[
                "lm_head",
                "model.embed_tokens",
                "visual",
                "merger",
                "deepstack",
                "model.visual.*"
            ],
            scheme="W4A16",
            config_groups={
                "group_0": {
                    "weights": {
                        "num_bits": 4,
                        "type": "int",
                        "symmetric": True,
                        "strategy": "group",
                        "group_size": 128
                    }
                }
            }
        )
    ]

    print("\nStarting oneshot calibration and quantization...")
    oneshot(
        model=args.model_path,
        dataset=calib_dataset,
        recipe=recipe,
        output_dir=args.output_dir,
        max_seq_length=2048,
        num_calibration_samples=len(calib_dataset),
        save_compressed=True
    )

    elapsed = time.time() - start_time
    print(f"\nQuantization completed in {elapsed/60:.2f} minutes.")
    print(f"Saved candidate artifact to: {args.output_dir}")


if __name__ == "__main__":
    main()
