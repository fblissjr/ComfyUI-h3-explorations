# This machine's locations, for bench/ tools, the workflow builder and shells.
#
# The real file is h3.env beside this one. git ignores it: it holds absolute paths and this repo is
# public. Never commit it and never copy a value from it into a tracked file. Write it with
#   <comfy>/.venv/bin/python bench/write_h3_env.py
# which discovers the first six keys (from <comfy>/start.sh and the model links); add the optional
# ones by hand. Python tools load it on their own (workflows/h3_env.py); a shell takes it with
#   set -a; . ./h3.env; set +a
# An exported variable always wins over the file.
#
# Locations only. Switches and per-run values never go here: H3_CAPTURE (arms a capture),
# H3_SESSION, H3_SOL_*, H3_TRACE, H3_DEVICE, H3_LLM_PROVIDER, H3_LLM_MODEL, H3_SINGLE_FRAME_DEBUG.

# ComfyUI's --output-directory in <comfy>/start.sh (renders, Video/<video>/, Image/)
H3_OUTPUT_DIR=
# ComfyUI's --input-directory in <comfy>/start.sh
H3_INPUT_DIR=
# The same two folders under bench/_paths.py's names
H3_COMFY_OUTPUT=
H3_COMFY_INPUT=
# The local model store: the folder <comfy>/models/sapiens2/ links into
H3_MODEL_STORE=
# Activation captures: $H3_MODEL_STORE/h3_captures
H3_CAPTURE_ROOT=

# Optional, by hand, when a tool needs it:
# The MiniMax-H3 release folder (bench/check_vendor_config.py --release)
# H3_RELEASE_DIR=
# EXL3 Qwen3-VL model folder (control-vector labelling)
# H3_EXL3_MODEL_DIR=
# Text-encoder file for bench/check_marker_arms.py
# H3_ENCODER_PATH=
# SAM 3D Body files for bench/check_sam3d_body_vith.py and bench/check_body_pose.py
# H3_SAM3D_VITH_FILE=
# H3_SAM3D_DINOV3_FILE=
# Control-vector pair and vector folders (bench/control_vector/)
# H3_CV_TOML_DIR=
# H3_CV_VEC_DIR=
# Page and server addresses (bench/rebuild_delivery.py, bench/control_vector/helpers.py)
# H3_REVIEW_PAGE_URL=
# H3_OPEN_LIST_URL=
# H3_COMFY_URL=
